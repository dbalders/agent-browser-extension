{
  "name": "agent-browser-extension",
  "version": "0.1.0",
  "description": "Autonomous Chrome sessions for AI agents, with a local bridge and MCP tools",
  "type": "module",
  "license": "Apache-2.0",
  "author": "David Balderston",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "bin": {
    "agent-browser-extension": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/package-extension.mjs && node scripts/export-catalog.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "benchmark": "node scripts/benchmark-serve.mjs",
    "dev": "tsx src/cli.ts serve",
    "mcp": "tsx src/cli.ts mcp",
    "check:release": "node scripts/check-release.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.60.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbalders/agent-browser-extension.git"
  },
  "homepage": "https://github.com/dbalders/agent-browser-extension#readme",
  "bugs": {
    "url": "https://github.com/dbalders/agent-browser-extension/issues"
  }
}
